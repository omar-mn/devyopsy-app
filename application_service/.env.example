# Local development values only. Production uses managed secrets and TLS.
PORT=3000
POSTGRES_USER=application_service
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=application_service
DATABASE_URL=postgresql://application_service:local-dev-password@localhost:5432/application_service
REDIS_URL=redis://localhost:6379/0

# Obtain only the PEM public key from the Auth Service developer.
# Tokens must contain user_id, token_type=access, exp, iss, and aud.
JWT_PUBLIC_KEY_FILE=./auth-public.pem
JWT_ISSUER=auth-service
JWT_AUDIENCE=infraops

# Generate a random token (at least 32 characters) and share it with Build Service.
BUILD_SERVICE_TOKEN=
BUILD_QUEUE=build
CELERY_KEY_PREFIX=
BUILD_PUBLISH_TIMEOUT_MS=2000
BUILD_PUBLISH_ATTEMPTS=3
BUILD_RATE_LIMIT=10
BUILD_RATE_WINDOW_SECONDS=60

# Comma-separated exact frontend origins, no wildcard and no trailing slash.
CORS_ORIGINS=http://localhost:5173
