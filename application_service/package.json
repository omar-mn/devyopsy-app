{
  "name": "@infraops/application-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Application metadata and build orchestration for InfraOps",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --test --test-reporter=spec --test-concurrency=1 test/*.test.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:celery": "node scripts/check-celery.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "eslint": "^10.0.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
